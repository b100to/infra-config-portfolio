FROM kong/kong-gateway:2.8.0.0-alpine

LABEL maintainer="Kong <support@konghq.com>"

ARG ASSET=ee
ENV ASSET $ASSET
# hadolint ignore=DL3010
ARG KONG_VERSION=2.8.0
ENV KONG_VERSION $KONG_VERSION

COPY kong.yml /kong/declarative/kong.yml

ARG KONG_AMD64_SHA="60ef680e0fc4d2cf52934758e6a0dc0f173d2a3b32aca49c7eb31ab478c24583"
ARG KONG_ARM64_SHA="5c23f448eeae1b363ece51d066405c13798ee08ca413097a23d9b5ccb49cbf35"

ARG KONG_DATABASE=off
ENV KONG_DATABASE $KONG_DATABASE

ARG KONG_DECLARATIVE_CONFIG=/kong/declarative/kong.yml
ENV KONG_DECLARATIVE_CONFIG $KONG_DECLARATIVE_CONFIG

ARG KONG_ADMIN_ACCESS_LOG=/dev/stdout
ENV KONG_ADMIN_ACCESS_LOG $KONG_ADMIN_ACCESS_LOG

ARG KONG_PROXY_ERROR_LOG=/dev/stderr
ENV KONG_PROXY_ERROR_LOG $KONG_PROXY_ERROR_LOG

ARG KONG_ADMIN_ERROR_LOG=/dev/stderr
ENV KONG_ADMIN_ERROR_LOG $KONG_ADMIN_ERROR_LOG

ARG KONG_ADMIN_LISTEN=0.0.0.0:8001
ENV KONG_ADMIN_LISTEN $KONG_ADMIN_LISTEN

ARG KONG_ADMIN_GUI_URL=http://localhost:8002
ENV KONG_ADMIN_GUI_URL $KONG_ADMIN_GUI_URL

EXPOSE 8000 8443 8001 8444 8002 8445 8003 8004

USER kong

CMD ["kong", "docker-start"]